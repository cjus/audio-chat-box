+  // Lexicon lines ("word sym sym ...", as in lexicon files) -> a request lexicon. A line
+  // with a symbol Kokoro lacks, or no word, is skipped.
+  RequestLexicon ParseRequestLexicon(const std::string &lines) const {
+    RequestLexicon out;
+    std::istringstream is(lines);
+    std::string line;
+    while (std::getline(is, line)) {
+      std::istringstream iss(line);
+      std::string word, token;
+      if (!(iss >> word)) continue;
+      ToLowerCase(&word);
+      std::vector<std::string> token_list;
+      while (iss >> token) token_list.push_back(std::move(token));
+      std::vector<int32_t> ids = ConvertTokensToIds(token2id_, token_list);
+      if (ids.empty()) continue;
+      out[std::move(word)] = std::move(ids);
+    }
+    return out;
+  }

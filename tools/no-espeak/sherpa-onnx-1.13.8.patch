+  // (Patched.) English words for a number, below a billion: "forty two", "nineteen
+  // seventy two" for a year, with `ordinal` ("forty second") or `decade` ("nineties").
+  static void NumberWords(uint64_t n, std::vector<std::string> *out) {
+    static const char *ones[] = {"zero", "one", "two", "three", "four", "five", "six",
+        "seven", "eight", "nine", "ten", "eleven", "twelve", "thirteen", "fourteen",
+        "fifteen", "sixteen", "seventeen", "eighteen", "nineteen"};
+    static const char *tens[] = {"", "", "twenty", "thirty", "forty", "fifty", "sixty",
+        "seventy", "eighty", "ninety"};
+    if (n >= 1000000) {
+      NumberWords(n / 1000000, out);
+      out->push_back("million");
+      if (n % 1000000) NumberWords(n % 1000000, out);
+    } else if (n >= 1000) {
+      NumberWords(n / 1000, out);
+      out->push_back("thousand");
+      if (n % 1000) NumberWords(n % 1000, out);
+    } else if (n >= 100) {
+      NumberWords(n / 100, out);
+      out->push_back("hundred");
+      if (n % 100) NumberWords(n % 100, out);
+    } else if (n >= 20) {
+      out->push_back(tens[n / 10]);
+      if (n % 10) out->push_back(ones[n % 10]);
+    } else {
+      out->push_back(ones[n]);
+    }
+  }
+
+  static std::string OrdinalWord(const std::string &w) {
+    static const std::unordered_map<std::string, std::string> irregular = {
+        {"one", "first"}, {"two", "second"}, {"three", "third"}, {"five", "fifth"},
+        {"eight", "eighth"}, {"nine", "ninth"}, {"twelve", "twelfth"}};
+    auto it = irregular.find(w);
+    if (it != irregular.end()) return it->second;
+    if (!w.empty() && w.back() == 'y') return w.substr(0, w.size() - 1) + "ieth";
+    return w + "th";
+  }
+
+  // A word that is a number ("4", "1972", "1990s", "2nd", "27th"): said as English
+  // words. A year is four digits from 1100 to 1999 or 2010 to 2099.
+  bool NumberIds(const std::string &word, std::vector<int32_t> *ids) const {
+    size_t d = 0;
+    while (d < word.size() && word[d] >= '0' && word[d] <= '9') ++d;
+    if (d == 0 || d > 9) return false;
+    std::string suffix = word.substr(d);
+    if (!suffix.empty() && suffix != "s" && suffix != "st" && suffix != "nd" &&
+        suffix != "rd" && suffix != "th") {
+      return false;
+    }
+    uint64_t n = std::stoull(word.substr(0, d));
+    std::vector<std::string> words;
+    if (d == 4 && ((n >= 1100 && n <= 1999) || (n >= 2010 && n <= 2099))) {
+      NumberWords(n / 100, &words);
+      uint64_t lo = n % 100;
+      if (lo == 0) {
+        words.push_back("hundred");
+      } else {
+        if (lo < 10) words.push_back("oh");
+        NumberWords(lo, &words);
+      }
+    } else {
+      NumberWords(n, &words);
+    }
+    if (suffix == "s") {
+      std::string &w = words.back();
+      w = (w.back() == 'y') ? w.substr(0, w.size() - 1) + "ies" : w + "s";
+    } else if (!suffix.empty()) {
+      words.back() = OrdinalWord(words.back());
+    }
+    std::vector<int32_t> out;
+    auto space = token2id_.find(" ");
+    for (const auto &w : words) {
+      const std::vector<int32_t> *found = Lookup(w);
+      std::vector<int32_t> inflected;
+      if (found == nullptr) {
+        if (!InflectedIds(w, &inflected)) return false;
+        found = &inflected;
+      }
+      if (!out.empty() && space != token2id_.end()) out.push_back(space->second);
+      out.insert(out.end(), found->begin(), found->end());
+    }
+    *ids = std::move(out);
+    return !ids->empty();
+  }
+
+  // A square or a short code written as one token ("f3", "e6", "qb6", "mp3"): one or two
+  // letters, said by their names, then a number of one or two digits. eSpeak read them
+  // this way; "a" is the letter, not the article.
+  bool SquareIds(const std::string &word, std::vector<int32_t> *ids) const {
+    size_t l = 0;
+    while (l < word.size() && word[l] >= 'a' && word[l] <= 'z') ++l;
+    if (l == 0 || l > 2 || word.size() - l == 0 || word.size() - l > 2) return false;
+    std::vector<int32_t> out;
+    auto space = token2id_.find(" ");
+    if (space == token2id_.end()) return false;
+    for (size_t i = 0; i < l; ++i) {
+      std::vector<int32_t> letter;
+      if (word[i] == 'a') {
+        auto a = token2id_.find("A");  // Kokoro's symbol for the vowel of "day"
+        if (a == token2id_.end()) return false;
+        letter = {a->second};
+      } else {
+        const std::vector<int32_t> *found = Lookup(std::string(1, word[i]));
+        if (found == nullptr) return false;
+        letter = *found;
+      }
+      if (!out.empty()) out.push_back(space->second);
+      out.insert(out.end(), letter.begin(), letter.end());
+    }
+    std::vector<int32_t> number;
+    if (!NumberIds(word.substr(l), &number)) return false;
+    out.push_back(space->second);
+    out.insert(out.end(), number.begin(), number.end());
+    *ids = std::move(out);
+    return true;
+  }
+
+  // A compound the lexicon lacks ("middlegame", "grandmasters"): two words it has, each of
+  // three letters or more, the first as long as it can be.
+  bool CompoundIds(const std::string &word, std::vector<int32_t> *ids) const {
+    if (word.size() < 6) return false;
+    for (char c : word) {
+      if (c < 'a' || c > 'z') return false;
+    }
+    for (size_t p = word.size() - 3; p >= 3; --p) {
+      const std::vector<int32_t> *a = Lookup(word.substr(0, p));
+      if (a == nullptr) continue;
+      std::string rest = word.substr(p);
+      const std::vector<int32_t> *b = Lookup(rest);
+      std::vector<int32_t> inflected;
+      if (b == nullptr) {
+        if (!InflectedIds(rest, &inflected)) continue;
+        b = &inflected;
+      }
+      std::vector<int32_t> out(a->begin(), a->end());
+      out.insert(out.end(), b->begin(), b->end());
+      *ids = std::move(out);
+      return true;
+    }
+    return false;
+  }
+
+
+  // (Patched, no eSpeak NG.) Pronounces an inflected word the lexicon lacks, from the lexicon's
+  // entry for its stem: "suggests" from "suggest", "stopped" from "stop", "castling's" from
+  // "castling". The suffix's sound depends on the stem's last sound, as in English
+  // generally (cats /s/, dogs /z/, boxes /iz/; walked /t/, jogged /d/, wanted /id/). The idea
+  // follows misaki's English G2P (hexgrad/misaki, Apache-2.0); this is a rewrite for sherpa-onnx's
+  // token ids, not a copy of its code.
+  bool InflectedIds(const std::string &word, std::vector<int32_t> *ids) const {
+    std::unordered_map<int32_t, std::string> id2token;
+    for (const auto &[tok, id] : token2id_) {
+      id2token[id] = tok;
+    }
+
+    auto ends = [&](const std::string &suffix) {
+      return word.size() > suffix.size() + 1 &&
+             word.compare(word.size() - suffix.size(), suffix.size(), suffix) ==
+                 0;
+    };
+    auto chop = [&](size_t n) { return word.substr(0, word.size() - n); };
+    auto undoubled = [](const std::string &stem) {
+      size_t n = stem.size();
+      return n > 2 && stem[n - 1] == stem[n - 2] ? stem.substr(0, n - 1) : stem;
+    };
+
+    // (stem to look up, kind of suffix): s plural or possessive, d past, g -ing, l -ly, r -er
+    std::vector<std::pair<std::string, char>> tries;
+    if (ends("'s")) tries.push_back({chop(2), 's'});
+    if (ends("s'")) tries.push_back({chop(1), '0'});
+    if (ends("ies")) tries.push_back({chop(3) + "y", 's'});
+    if (ends("es")) tries.push_back({chop(2), 's'});
+    if (ends("s") && !ends("ss") && !ends("'s")) tries.push_back({chop(1), 's'});
+    if (ends("ied")) tries.push_back({chop(3) + "y", 'd'});
+    if (ends("ed")) {
+      tries.push_back({chop(2), 'd'});
+      tries.push_back({chop(1), 'd'});
+      tries.push_back({undoubled(chop(2)), 'd'});
+    }
+    if (ends("ing")) {
+      tries.push_back({chop(3), 'g'});
+      tries.push_back({chop(3) + "e", 'g'});
+      tries.push_back({undoubled(chop(3)), 'g'});
+    }
+    if (ends("ly")) tries.push_back({chop(2), 'l'});
+    if (ends("er")) {
+      tries.push_back({chop(2), 'r'});
+      tries.push_back({chop(1), 'r'});
+    }
+
+    for (const auto &[stem, kind] : tries) {
+      const std::vector<int32_t> *found = Lookup(stem);
+      if (found == nullptr) continue;
+      const std::vector<int32_t> &stem_ids = *found;
+
+      // The stem's last sound, skipping stress and length marks.
+      std::string last;
+      for (auto i = stem_ids.rbegin(); i != stem_ids.rend(); ++i) {
+        const std::string &t = id2token[*i];
+        if (t == "ˈ" || t == "ˌ" || t == "ː") continue;
+        last = t;
+        break;
+      }
+      std::vector<std::string> suffix;
+      switch (kind) {
+        case 's':
+          if (last == "p" || last == "t" || last == "k" || last == "f" ||
+              last == "θ") {
+            suffix = {"s"};
+          } else if (last == "s" || last == "z" || last == "ʃ" ||
+                     last == "ʒ" || last == "ʧ" || last == "ʤ") {
+            suffix = {"ᵻ", "z"};
+          } else {
+            suffix = {"z"};
+          }
+          break;
+        case 'd':
+          if (last == "p" || last == "k" || last == "f" || last == "θ" ||
+              last == "ʃ" || last == "s" || last == "ʧ") {
+            suffix = {"t"};
+          } else if (last == "d" || last == "t") {
+            suffix = {"ᵻ", "d"};
+          } else {
+            suffix = {"d"};
+          }
+          break;
+        case 'g': suffix = {"ɪ", "ŋ"}; break;
+        case 'l': suffix = {"l", "i"}; break;
+        case 'r': suffix = {"ɚ"}; break;
+        default: break;  // '0': the stem as it is
+      }
+      *ids = stem_ids;
+      for (const auto &t : suffix) {
+        auto tk = token2id_.find(t);
+        if (tk == token2id_.end()) {
+          ids->clear();
+          break;
+        }
+        ids->push_back(tk->second);
+      }
+      if (!ids->empty()) return true;
+    }
+    return false;
+  }
